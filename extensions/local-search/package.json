{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "local-search",
  "title": "Lokalt søk",
  "description": "Søk i lokale masteroppgaver, Turatlas og reMarkable-notater.",
  "icon": "icon.png",
  "author": "larsbogen",
  "contributors": [],
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity",
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-theses",
      "title": "Søk i masteroppgaver",
      "description": "Søk i masteroppgaver",
      "mode": "view"
    },
    {
      "name": "search-atlas",
      "title": "Søk i Turatlas",
      "description": "Søk i Turatlas",
      "mode": "view"
    },
    {
      "name": "search-remarkable-notes",
      "title": "Søk i mine reMarkable-notater",
      "description": "Finn håndskrevne kommentarer og avsnittene ved siden av i lokale PDF-eksporter.",
      "keywords": [
        "håndskrift",
        "margnotater",
        "reMarkable",
        "PDF"
      ],
      "mode": "view",
      "preferences": [
        {
          "name": "remarkableNotesPath",
          "title": "Importmappe",
          "description": "Velg den lokale mappen med PDF-eksportene og originalene.",
          "type": "directory",
          "required": true
        }
      ]
    },
    {
      "name": "local-services",
      "title": "Lokale tjenester",
      "description": "Vis status, start, stopp og les logger for lokale tjenester.",
      "keywords": [
        "tjenester",
        "server",
        "status",
        "start",
        "stopp",
        "logg",
        "turatlas",
        "masteroppgaver"
      ],
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.3",
    "@raycast/utils": "^2.2.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "react-test-renderer": "^19.0.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "ray build -e dist --output ./dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "eslint src tests && prettier --check src tests package.json tsconfig.json eslint.config.js",
    "test": "vitest run --maxWorkers=1 && sh scripts/build-notes.sh test",
    "typecheck": "tsc --noEmit",
    "lint:store": "ray lint",
    "prebuild": "sh scripts/build-notes.sh",
    "predev": "sh scripts/build-notes.sh"
  },
  "preferences": [
    {
      "name": "libraryPath",
      "title": "Mappe til biblioteket",
      "type": "textfield",
      "required": false,
      "description": "Mappe til biblioteket"
    },
    {
      "name": "atlasPath",
      "title": "Mappe til Turatlas",
      "type": "textfield",
      "required": false,
      "description": "Mappe til Turatlas"
    },
    {
      "name": "nodePath",
      "title": "Node-program",
      "type": "textfield",
      "required": false,
      "description": "Node-program"
    },
    {
      "name": "pythonPath",
      "title": "Python-program",
      "type": "textfield",
      "required": false,
      "description": "Python-program"
    }
  ]
}
