+++ b/tests/test_cloud_fresh.py
@@ -0,0 +1,115 @@
+import base64
+import json
+import time
+from types import SimpleNamespace
+
+import httpx
+import pytest
+
+from remarkable_cli.cloud import CloudClient, CloudError, CloudOperationError, WebCloudClient, cloud_item_from_web_metadata
+
+FOLDER = '33333333-3333-4333-8333-333333333333'
+REMOVED = '11111111-1111-4111-8111-111111111111'
+ROOT, DOC, META = 'a'*64, 'b'*64, 'c'*64
+
+
+def jwt(**claims):
+    return 'header.' + base64.urlsafe_b64encode(json.dumps(claims).encode()).decode().rstrip('=') + '.signature'
+
+
+class Store:
+    def __init__(self, expires=None, subject='account'):
+        self.user = jwt(exp=expires if expires is not None else time.time()+1000, sub=subject, tectonic='eu')
+    def get_user_token(self):
+        return SimpleNamespace(token=self.user, timestamp=time.time(), source='keychain')
+    def get_web_token(self):
+        return SimpleNamespace(token=jwt(sub='account'), source='keychain')
+    def get_web_api_base(self):
+        return SimpleNamespace(token='https://web.eu.tectonic.remarkable.com', source='keychain')
+
+
+def fresh_client(outcome='ok'):
+    seen = []
+    roots = []
+    def handler(request):
+        seen.append(request)
+        if request.method != 'GET':
+            pytest.fail('Must never write or create duplicate folders')
+        if request.url.path == '/doc/v2/files':
+            # This is exactly the observed bug: a successful but stale web list.
+            return httpx.Response(200, json=[{'id':REMOVED, 'hash':'d'*64, 'visibleName':'Removed', 'type':'CollectionType'}])
+        if request.url.path.endswith('/root'):
+            roots.append(1)
+            return httpx.Response(200, json={'hash':'e'*64 if outcome=='changed' and len(roots)>1 else ROOT})
+        digest = request.url.path.rsplit('/',1)[-1]
+        if outcome == 'failed': return httpx.Response(503)
+        if digest == ROOT:
+            assert request.headers['rm-filename'] == 'root.docSchema'
+            return httpx.Response(200, text=f'4\n0:.:1:99\n{DOC}:80000000:{FOLDER}:2:99\n')
+        if digest == DOC:
+            assert request.headers['rm-filename'] == FOLDER+'.docSchema'
+            return httpx.Response(200, text=f'4\n0:{FOLDER}:1:99\n{META}:0:{FOLDER}.metadata:0:99\n' if outcome!='missing' else '3\n')
+        if digest == META:
+            assert request.headers['rm-filename'] == FOLDER+'.metadata'
+            return httpx.Response(200, json={'type':'CollectionType', 'visibleName':'Dagsplaner', 'parent':''})
+        pytest.fail('Unexpected request')
+    return WebCloudClient(token_store=Store(),http_client=httpx.Client(transport=httpx.MockTransport(handler))), seen
+
+
+def test_reconciles_stale_web_list_and_excludes_removed_ids():
+    web, seen = fresh_client()
+    items = web.fresh_items()
+    assert [(i.metadata['id'],i.name,i.parent) for i in items] == [(FOLDER,'Dagsplaner','')]
+    assert len(seen)==6
+
+
+def test_existing_folder_missing_from_web_list_is_reused_without_post():
+    web, seen = fresh_client()
+    assert web.create_folder('Dagsplaner').metadata['id']==FOLDER
+    assert all(r.method=='GET' for r in seen)
+
+
+@pytest.mark.parametrize('outcome',['failed','missing','changed'])
+def test_no_stale_fallback_or_post_on_incomplete_sync_read(outcome):
+    web, seen = fresh_client(outcome)
+    with pytest.raises(CloudError): web.create_folder('Dagsplaner')
+    assert all(r.method=='GET' for r in seen)
+
+
+def test_rejects_different_accounts_before_sync_read():
+    client=CloudClient(token_store=Store(subject='other'),http_client=httpx.Client(transport=httpx.MockTransport(lambda r:pytest.fail('network'))))
+    with pytest.raises(CloudOperationError) as error: client.reconcile_items([],jwt(sub='account'))
+    assert error.value.code=='account_mismatch'
+
+
+def test_expired_jwt_refreshes_even_if_saved_recently(monkeypatch):
+    client=CloudClient(token_store=Store(expires=time.time()-1))
+    monkeypatch.setattr(client,'refresh_user_token',lambda:'refreshed')
+    assert client.user_token()=='refreshed'
+
+
+def test_valid_jwt_does_not_refresh(monkeypatch):
+    store=Store();client=CloudClient(token_store=store)
+    monkeypatch.setattr(client,'refresh_user_token',lambda:pytest.fail('unnecessary refresh'))
+    assert client.user_token()==store.user
+
+
+def test_near_expiry_refreshes_before_starting_request(monkeypatch):
+    client=CloudClient(token_store=Store(expires=time.time()+10))
+    monkeypatch.setattr(client,'refresh_user_token',lambda:'refreshed')
+    assert client.user_token()=='refreshed'
+
+
+def test_identical_hash_reuses_metadata_and_remaps_parent(monkeypatch):
+    web, seen=fresh_client()
+    cached=cloud_item_from_web_metadata({'id':FOLDER,'hash':DOC,'visibleName':'Dagsplaner','type':'CollectionType','parent':''})
+    monkeypatch.setattr(web,'list_items',lambda:[cached])
+    assert web.fresh_items()[0].name=='Dagsplaner'
+    assert len(seen)==3  # two root reads and one root index, no metadata downloads
+
+
+def test_sync_index_accepts_v3_and_checks_v4_count():
+    from remarkable_cli.cloud import sync_index
+    assert sync_index(f'3\n{DOC}:80000000:{FOLDER}:2:99\n') == [(DOC,FOLDER)]
+    with pytest.raises(CloudError, match="count"):
+        sync_index('4\n0:.:2:99\n')
