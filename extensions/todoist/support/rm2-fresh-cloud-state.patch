+def token_claims(token: str) -> Dict[str, Any]:
+    """Inspect our stored JWT for routing/expiry only; the server validates it."""
+    try:
+        payload = token.split(".")[1]
+        claims = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
+        return claims if isinstance(claims, dict) else {}
+    except (ValueError, IndexError, UnicodeError):
+        return {}
+
+
+def sync_index(data: str) -> List[Tuple[str, str]]:
+    lines = data.splitlines()
+    if not lines or lines[0] not in ("3", "4"):
+        raise CloudError("Unsupported Cloud sync index")
+    body = lines[1:]
+    if lines[0] == "4":
+        header = body[0].split(":") if body else []
+        if len(header) != 4 or not header[2].isdigit() or int(header[2]) != len(body) - 1:
+            raise CloudError("Invalid Cloud sync index count")
+        body = body[1:]
+    entries = []
+    for line in body:
+        if not line:
+            continue
+        fields = line.split(":")
+        if len(fields) != 5 or not re.fullmatch(r"[0-9a-f]{64}", fields[0]):
+            raise CloudError("Invalid Cloud sync index")
+        entries.append((fields[0], fields[2]))
+    return entries
+
+
