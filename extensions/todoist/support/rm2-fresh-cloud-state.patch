+    def reconcile_items(self, items: List[CloudItem], web_token: str) -> List[CloudItem]:
+        """Reconcile the lagging web index with a fresh read-only sync root.
+
+        Reuse web metadata only for identical content hashes. Fetch changed/new
+        metadata, exclude removed IDs, then confirm that the root stayed stable.
+        Never use old metadata if any read fails.
+        """
+        try:
+            token = self.user_token()
+        except CloudAuthError as error:
+            raise CloudOperationError("Upload login required for fresh listing", "upload_auth") from error
+        claims, web_claims = token_claims(token), token_claims(web_token)
+        if not claims.get("sub") or claims.get("sub") != web_claims.get("sub"):
+            raise CloudOperationError("Cloud logins belong to different accounts", "account_mismatch")
+        region = claims.get("tectonic")
+        if not isinstance(region, str) or not re.fullmatch(r"[a-z]{2}(?:-[a-z0-9]+)?", region):
+            raise CloudError("Cloud storage region is unavailable")
+        base = f"https://{region}.tectonic.remarkable.com/sync/v3/"
+
+        def get(suffix: str, filename: str = "") -> httpx.Response:
+            response = self._raw_request("GET", base + suffix, token=token,
+                                         headers={"rm-filename": filename} if filename else {})
+            if response.status_code in (401, 403):
+                raise CloudOperationError("Upload login required for fresh listing", "upload_auth")
+            if response.status_code != 200:
+                raise CloudError("Could not read fresh Cloud state")
+            return response
+
+        def root_hash() -> str:
+            digest = get("root").json().get("hash")
+            if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
+                raise CloudError("Invalid Cloud root")
+            return digest
+
+        root = root_hash()
+        entries = sync_index(get("files/" + root, "root.docSchema").text)
+        by_id = {canonical_document_id(item): item for item in items}
+        result = []
+        for digest, document_id in entries:
+            try:
+                if str(uuid.UUID(document_id)) != document_id:
+                    raise ValueError()
+            except ValueError as error:
+                raise CloudError("Invalid document ID in Cloud index") from error
+            cached = by_id.get(document_id)
+            if cached and cached.id == digest:
+                # Existing web parents may be read hashes. Normalize after merging.
+                result.append(cached)
+                continue
+            files = sync_index(get("files/" + digest, document_id + ".docSchema").text)
+            metadata = [(h, n) for h, n in files if n == document_id + ".metadata"]
+            if len(metadata) != 1:
+                raise CloudError("Cloud document metadata is missing")
+            metadata_hash, filename = metadata[0]
+            value = get("files/" + metadata_hash, filename).json()
+            if not isinstance(value, dict):
+                raise CloudError("Invalid Cloud document metadata")
+            result.append(cloud_item_from_web_metadata({**value, "id": document_id, "hash": digest}))
+        if root_hash() != root:
+            raise CloudError("Cloud changed during listing; refresh the list")
+        # Web rows used old parent hashes; remap those through canonical IDs first.
+        old_ids = {item.id: canonical_document_id(item) for item in items}
+        result = [replace(item, parent=old_ids.get(item.parent) or item.parent) for item in result]
+        return normalize_web_parent_ids(result)

