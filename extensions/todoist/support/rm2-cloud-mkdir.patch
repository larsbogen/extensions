diff --git a/tests/test_cloud_folders.py b/tests/test_cloud_folders.py
new file mode 100644
--- /dev/null
+++ b/tests/test_cloud_folders.py
@@ -0,0 +1,134 @@
+"""Folder creation contract captured from reMarkable's own public My files client."""
+import base64
+import json
+from types import SimpleNamespace
+
+import httpx
+import pytest
+
+from remarkable_cli.cli import main
+from remarkable_cli.cloud import CloudAuthError, CloudOperationError, WebCloudClient, app_cloud_item
+
+FOLDER = "35a268ba-0b99-425b-856c-5c92fd363e4c"
+PARENT = "deaf0a4e-5a76-4863-8d2e-e4083dd82f63"
+
+class Store:
+    def get_web_token(self):
+        return SimpleNamespace(token="test-token", source="test")
+    def get_web_api_base(self):
+        return SimpleNamespace(token="https://web.eu.tectonic.remarkable.com", source="test")
+
+
+def client(handler):
+    return WebCloudClient(token_store=Store(), http_client=httpx.Client(transport=httpx.MockTransport(handler)))
+
+
+def test_create_folder_matches_current_web_client_contract():
+    seen = []
+    def handler(request):
+        seen.append(request)
+        assert request.url.path == "/doc/v2/files"
+        if request.method == "GET":
+            return httpx.Response(200, json=[])
+        assert request.method == "POST"
+        assert request.headers["Content-Type"] == "folder"
+        assert request.headers["rm-source"] == "WebLibrary"
+        assert request.content == b""
+        assert json.loads(base64.b64decode(request.headers["rm-meta"])) == {"file_name": "Dagsplaner æøå", "parent": ""}
+        return httpx.Response(201, json={"docID": FOLDER, "hash": "new-read-hash"})
+    item = client(handler).create_folder(" Dagsplaner æøå ")
+    assert app_cloud_item(item)["upload_parent_id"] == FOLDER
+    assert item.id == "new-read-hash"
+    assert [r.method for r in seen] == ["GET", "POST"]
+
+
+def test_reuses_existing_folder_in_same_parent_without_writing():
+    def handler(request):
+        assert request.method == "GET"
+        return httpx.Response(200, json=[
+            {"id": PARENT, "hash": "parent-hash", "visibleName": "Arbeid", "type": "CollectionType"},
+            {"id": FOLDER, "hash": "folder-hash", "visibleName": "Dagsplaner", "type": "CollectionType", "parent": PARENT},
+        ])
+    assert app_cloud_item(client(handler).create_folder("dagsplaner", PARENT))["upload_parent_id"] == FOLDER
+
+
+def test_create_in_verified_parent_sends_uuid_not_read_hash():
+    def handler(request):
+        if request.method == "GET":
+            return httpx.Response(200, json=[{"id": PARENT, "hash": "parent-hash", "type": "CollectionType"}])
+        assert json.loads(base64.b64decode(request.headers["rm-meta"]))["parent"] == PARENT
+        return httpx.Response(200, json={"docID": FOLDER})
+    assert app_cloud_item(client(handler).create_folder("Ny", PARENT))["upload_parent_id"] == FOLDER
+
+
+@pytest.mark.parametrize("name", ["", "  ", "A/B", "A\\B", "A\nB", "x" * 256])
+def test_invalid_names_never_contact_cloud(name):
+    def handler(request):
+        pytest.fail("Must not contact Cloud")
+    with pytest.raises(CloudOperationError, match="Invalid folder name"):
+        client(handler).create_folder(name)
+
+
+def test_missing_parent_stops_before_write():
+    def handler(request):
+        assert request.method == "GET"
+        return httpx.Response(200, json=[])
+    with pytest.raises(CloudOperationError) as error:
+        client(handler).create_folder("Ny", PARENT)
+    assert error.value.code == "invalid_parent"
+
+
+@pytest.mark.parametrize("outcome", ["timeout", "server", "missing_id", "bad_id", "empty"])
+def test_uncertain_creation_never_retries(outcome):
+    posts = []
+    def handler(request):
+        if request.method == "GET":
+            return httpx.Response(200, json=[])
+        posts.append(request)
+        if outcome == "timeout":
+            raise httpx.ReadTimeout("raw secret must not escape", request=request)
+        if outcome == "server":
+            return httpx.Response(503, text="raw secret")
+        if outcome == "empty":
+            return httpx.Response(204)
+        return httpx.Response(200, json={} if outcome == "missing_id" else {"docID": 42})
+    with pytest.raises(CloudOperationError) as error:
+        client(handler).create_folder("Ny")
+    assert error.value.code == "folder_uncertain"
+    assert error.value.may_have_uploaded
+    assert "secret" not in str(error.value)
+    assert len(posts) == 1
+
+
+def test_expired_auth_does_not_create_a_folder():
+    def handler(request):
+        assert request.method == "GET"
+        return httpx.Response(401)
+    with pytest.raises(CloudAuthError):
+        client(handler).create_folder("Ny")
+
+
+def test_mkdir_app_protocol_and_capability(monkeypatch, capsys):
+    def handler(request):
+        if request.method == "GET":
+            return httpx.Response(200, json=[])
+        return httpx.Response(200, json={"docID": FOLDER})
+    monkeypatch.setattr("remarkable_cli.cli.make_web_cloud_client", lambda args: client(handler))
+    assert main(["cloud", "mkdir", "Dagsplaner", "--app-json"]) == 0
+    payload = json.loads(capsys.readouterr().out)
+    assert payload["ok"]
+    assert payload["data"]["upload_parent_id"] == FOLDER
+    assert main(["cloud", "capabilities", "--json"]) == 0
+    assert "create_folder" in json.loads(capsys.readouterr().out)["data"]["features"]
+
+
+def test_mkdir_errors_are_structured_and_redacted(monkeypatch, capsys):
+    def handler(request):
+        if request.method == "GET":
+            return httpx.Response(200, json=[])
+        raise httpx.ReadTimeout("secret-token", request=request)
+    monkeypatch.setattr("remarkable_cli.cli.make_web_cloud_client", lambda args: client(handler))
+    assert main(["cloud", "mkdir", "Dagsplaner", "--json"]) == 1
+    output = capsys.readouterr().out
+    assert "secret-token" not in output
+    assert json.loads(output)["error"]["code"] == "folder_uncertain"
