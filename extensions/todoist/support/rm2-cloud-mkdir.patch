+    def create_folder(self, name: str, parent: str = "") -> CloudItem:
+        """Create/reuse a folder using the same endpoint as My files (2026-09-24).
+
+        POST doc/v2/files, Content-Type: folder, empty body and base64 rm-meta.
+        A name match is reused; writes are never automatically retried.
+        """
+        name = name.strip()
+        if not name or len(name) > 255 or any(ord(c) < 32 or c in "/\\" for c in name):
+            raise CloudOperationError("Invalid folder name", "invalid_name")
+        parent = "" if parent in ("", "/") else parent
+        if parent:
+            try:
+                parent = str(uuid.UUID(parent))
+            except ValueError as error:
+                raise CloudOperationError("Invalid parent", "invalid_parent") from error
+        items = self.list_items()  # Verify web authentication before attempting a write.
+        parent_read_id = ROOT_ID
+        if parent:
+            parents = [item for item in items if canonical_document_id(item) == parent
+                       and item.kind == "folder" and not item.deleted]
+            if len(parents) != 1:
+                raise CloudOperationError("Parent is unavailable", "invalid_parent")
+            parent_read_id = parents[0].id
+        matches = [item for item in items if item.kind == "folder" and not item.deleted
+                   and item.parent == parent_read_id and item.name.casefold() == name.casefold()]
+        if len(matches) > 1 or (matches and not canonical_document_id(matches[0])):
+            raise CloudOperationError("Choose an existing folder explicitly", "duplicate_folder")
+        if matches:
+            return matches[0]
+
+        token, api_base = self._auth()
+        try:
+            response = self._raw_request(
+                "POST", f"{api_base}/doc/v2/files", token=token, content=b"",
+                headers={"Accept": "application/json", "Content-Type": "folder",
+                         "rm-source": SYNC15_SOURCE,
+                         "rm-meta": encode_rm_meta({"file_name": name, "parent": parent})},
+            )
+        except CloudError as error:
+            raise CloudOperationError("Folder creation could not be confirmed", "folder_uncertain", True) from error
+        if response.status_code in (401, 403):
+            raise CloudAuthError(f"Cloud web login is required. {WEB_TOKEN_RENEWAL_MESSAGE}")
+        if response.status_code >= 500:
+            raise CloudOperationError("Folder creation could not be confirmed", "folder_uncertain", True)
+        if not 200 <= response.status_code < 300:
+            raise CloudOperationError("Cloud rejected folder creation", "folder_rejected")
+        try:
+            payload = response.json()
+            document_id = str(uuid.UUID(payload["docID"]))
+            metadata = {"id": document_id, "visibleName": name, "parent": parent,
+                        "type": "CollectionType"}
+            if isinstance(payload.get("hash"), str) and payload["hash"]:
+                metadata["hash"] = payload["hash"]
+            return cloud_item_from_web_metadata(metadata)
+        except (ValueError, KeyError, TypeError, AttributeError) as error:
+            raise CloudOperationError("Folder ID was not confirmed", "folder_uncertain", True) from error
+
